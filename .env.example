# App
APP_PORT=8080
APP_CONTAINER_NAME=jobhunter-app

# Database
POSTGRES_VERSION=17
POSTGRES_PORT=5432
POSTGRES_DB=jobhunter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_CONTAINER_NAME=jobhunter-db

# PgAdmin (optional, enable with --profile tools)
PGADMIN_VERSION=8
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_CONTAINER_NAME=pgadmin

# Security
JWT_BASE64_SECRET=U29tZVZlcnlMb25nU2VjcmV0S2V5Rm9yU2lnbmluZ0pXVHdpdGg1MTI=
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000

# Client origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://summer-project-fe.vercel.app
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000
